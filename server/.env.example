# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
# Exactly true/false; absent defaults to false. Requires backend restart.
# true blocks API writes for every role while allowing GET/HEAD/OPTIONS.
MAINTENANCE_READ_ONLY=false

# MongoDB Atlas connection string
# Atlas -> Database -> Connect -> Drivers. Replace <password> and add the db name.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/yogabliss?retryWrites=true&w=majority

# JWT
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — the deployed frontend origin (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary — media (images + video) storage. Optional locally (falls back to disk),
# REQUIRED in production so uploads persist. Cloudinary Dashboard -> Product Environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private account credentials for an explicitly requested LOCAL seed only.
# The seed deletes existing data. Never use it to rotate a deployed password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Both passwords require 12+ characters; admin and learner emails must differ.
SEED_LEARNER_EMAIL=
SEED_LEARNER_PASSWORD=
# Optional display names; generic local names are used when omitted.
SEED_ADMIN_NAME=
SEED_LEARNER_NAME=
